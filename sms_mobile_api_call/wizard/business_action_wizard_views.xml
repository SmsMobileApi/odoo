<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smsmobileapi_business_action_wizard_form" model="ir.ui.view">
        <field name="name">smsmobileapi.business.action.wizard.form</field>
        <field name="model">smsmobileapi.business.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Create an Odoo action">
                <sheet>
                    <div class="smsmobileapi_wizard_intro">
                        <span class="smsmobileapi_wizard_icon fa fa-bolt" title="Odoo action" aria-label="Odoo action"/>
                        <div>
                            <h2>Turn this mobile event into work</h2>
                            <p>Create a commercial or operational follow-up without copying the contact, number or message.</p>
                        </div>
                    </div>
                    <field name="activity_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_number"/>
                            <field name="action_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="assigned_user_id" widget="many2one_avatar_user" invisible="action_type == 'link'"/>
                            <field name="deadline" invisible="action_type not in ('task', 'followup')"/>
                            <field name="priority" widget="priority" invisible="action_type in ('quotation', 'link')"/>
                            <field name="project_id" invisible="action_type != 'task'"/>
                        </group>
                    </group>
                    <group invisible="action_type == 'link'">
                        <field name="name" colspan="2"/>
                        <field name="description" colspan="2" nolabel="1"/>
                    </group>
                    <group string="Existing document" invisible="action_type != 'link'">
                        <field name="sale_order_id" options="{'no_create': True}"/>
                        <field name="invoice_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create" type="object" string="Create and open" class="btn-primary" data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
