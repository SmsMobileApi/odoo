<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="quick_reply_received" model="smsmobileapi.quick.reply">
        <field name="name">Message received</field>
        <field name="message">I received your message and will reply shortly.</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">10</field>
    </record>
    <record id="quick_reply_callback" model="smsmobileapi.quick.reply">
        <field name="name">Call back</field>
        <field name="message">Thank you. I will call you back as soon as possible.</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">20</field>
    </record>
    <record id="quick_reply_processing" model="smsmobileapi.quick.reply">
        <field name="name">Request in progress</field>
        <field name="message">Your request is being processed. I will keep you informed.</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="sequence">30</field>
    </record>
</odoo>
