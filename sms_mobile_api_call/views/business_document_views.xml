<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_smsmobileapi" model="ir.ui.view">
        <field name="name">account.move.form.smsmobileapi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_smsmobileapi_send_invoice" type="object" string="Send invoice by SMS" icon="fa-mobile" groups="sms_mobile_api_call.group_smsmobileapi_user" invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'"/>
                <button name="action_smsmobileapi_payment_reminder" type="object" string="SMS payment reminder" icon="fa-bell" groups="sms_mobile_api_call.group_smsmobileapi_user" invisible="move_type != 'out_invoice' or state != 'posted' or payment_state == 'paid'"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_smsmobileapi" model="ir.ui.view">
        <field name="name">sale.order.form.smsmobileapi</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_smsmobileapi_send_document" type="object" string="Send by SMS" icon="fa-mobile" groups="sms_mobile_api_call.group_smsmobileapi_user" invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_smsmobileapi" model="ir.ui.view">
        <field name="name">purchase.order.form.smsmobileapi</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_smsmobileapi_send_document" type="object" string="Send by SMS" icon="fa-mobile" groups="sms_mobile_api_call.group_smsmobileapi_user" invisible="state == 'cancel'"/>
            </xpath>
        </field>
    </record>
</odoo>
