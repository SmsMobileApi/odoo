<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smsmobileapi_conversation_tree" model="ir.ui.view">
        <field name="name">smsmobileapi.conversation.tree</field>
        <field name="model">smsmobileapi.conversation</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" decoration-info="unread_count &gt; 0" decoration-muted="state == 'archived'">
                <field name="priority" widget="priority"/>
                <field name="last_activity_at"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="last_event_type" widget="badge"/>
                <field name="last_message_preview" string="Latest activity"/>
                <field name="last_mobile_id" optional="show"/>
                <field name="assigned_user_id" widget="many2one_avatar_user"/>
                <field name="unread_count" string="Unread"/>
                <field name="state" widget="badge"/>
                <button name="action_open" type="object" string="Open" icon="fa-comments"/>
            </tree>
        </field>
    </record>

    <record id="view_smsmobileapi_conversation_kanban" model="ir.ui.view">
        <field name="name">smsmobileapi.conversation.kanban</field>
        <field name="model">smsmobileapi.conversation</field>
        <field name="arch" type="xml">
            <kanban create="false" default_order="last_activity_at desc" class="o_smsmobileapi_inbox_kanban">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="last_activity_at"/>
                <field name="last_message_preview"/>
                <field name="last_event_type"/>
                <field name="assigned_user_id"/>
                <field name="unread_count"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_smsmobileapi_inbox_card {{ record.unread_count.raw_value ? 'o_smsmobileapi_unread' : '' }}">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="text-truncate">
                                    <strong class="fs-5"><field name="name"/></strong>
                                    <div class="text-muted small"><field name="last_activity_at"/></div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span t-if="record.unread_count.raw_value" class="badge rounded-pill text-bg-primary">
                                        <t t-esc="record.unread_count.raw_value"/> unread
                                    </span>
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            <div class="o_smsmobileapi_preview my-3">
                                <span class="badge rounded-pill text-bg-light me-2"><field name="last_event_type"/></span>
                                <span><field name="last_message_preview"/></span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <span class="text-muted small" t-if="record.assigned_user_id.raw_value">
                                    <i class="fa fa-user me-1" title="Assigned user"/><field name="assigned_user_id"/>
                                </span>
                                <span class="text-muted small" t-else="">Unassigned</span>
                                <div class="d-flex gap-1">
                                    <button name="action_reply" type="object" class="btn btn-sm btn-primary" title="Reply">
                                        <i class="fa fa-reply"/> Reply
                                    </button>
                                    <button name="action_assign_to_me" type="object" class="btn btn-sm btn-outline-secondary" title="Assign to me">
                                        <i class="fa fa-user-plus"/>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_smsmobileapi_conversation_form" model="ir.ui.view">
        <field name="name">smsmobileapi.conversation.form</field>
        <field name="model">smsmobileapi.conversation</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" class="o_smsmobileapi_conversation_form">
                <header>
                    <button name="action_reply" type="object" string="Reply by SMS" class="oe_highlight" icon="fa-reply"/>
                    <button name="action_create_business_action" type="object" string="Create Odoo action" icon="fa-bolt"/>
                    <button name="action_assign_to_me" type="object" string="Assign to me" icon="fa-user-plus" invisible="assigned_user_id == uid"/>
                    <button name="action_mark_read" type="object" string="Mark all read" icon="fa-check" invisible="unread_count == 0"/>
                    <button name="action_mark_done" type="object" string="Resolve" icon="fa-check-circle" invisible="state in ('done', 'archived')"/>
                    <button name="action_archive" type="object" string="Archive" icon="fa-archive" invisible="state == 'archived'"/>
                    <button name="action_reopen" type="object" string="Reopen" icon="fa-undo" invisible="state not in ('done', 'archived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,open,done,archived"/>
                </header>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_mark_read" type="object" class="oe_stat_button" icon="fa-envelope-open" invisible="unread_count == 0">
                            <field name="unread_count" widget="statinfo" string="Unread"/>
                        </button>
                        <div class="oe_stat_button">
                            <span class="o_stat_value"><field name="activity_count"/></span>
                            <span class="o_stat_text">Events</span>
                        </div>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="state != 'archived'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone_number" readonly="1"/>
                            <field name="assigned_user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="last_activity_at" readonly="1"/>
                            <field name="mobile_filter_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <div class="alert alert-info py-2" role="alert" invisible="not mobile_filter_id">
                        The timeline is filtered by the selected mobile. Clear the field to display every event.
                    </div>
                    <field name="filtered_activity_ids" nolabel="1" readonly="1">
                        <kanban create="false" delete="false" default_order="activity_at asc" class="o_smsmobileapi_thread">
                            <field name="activity_at"/>
                            <field name="event_type"/>
                            <field name="direction"/>
                            <field name="message"/>
                            <field name="duration_seconds"/>
                            <field name="status"/>
                            <field name="mobile_id"/>
                            <field name="is_read"/>
                            <templates>
                                <t t-name="kanban-box">
                                    <div t-attf-class="o_smsmobileapi_bubble {{ record.direction.raw_value === 'outgoing' ? 'o_smsmobileapi_outgoing' : 'o_smsmobileapi_incoming' }}">
                                        <div class="d-flex justify-content-between gap-3 mb-1">
                                            <strong><field name="event_type"/></strong>
                                            <span class="text-muted small"><field name="activity_at"/></span>
                                        </div>
                                        <div t-if="record.event_type.raw_value === 'sms'" class="o_smsmobileapi_message_text">
                                            <field name="message"/>
                                        </div>
                                        <div t-else="" class="text-muted">
                                            Call activity <span t-if="record.duration_seconds.raw_value">— <field name="duration_seconds"/> seconds</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                            <div class="small text-muted">
                                                <field name="status" widget="badge"/>
                                                <span t-if="record.mobile_id.raw_value" class="ms-2"><i class="fa fa-mobile" title="Mobile used"/> <field name="mobile_id"/></span>
                                            </div>
                                            <div class="d-flex gap-1">
                                                <button t-if="record.event_type.raw_value === 'sms' and record.direction.raw_value === 'incoming'" name="action_reply" type="object" class="btn btn-sm btn-primary">
                                                    <i class="fa fa-reply"/> Reply
                                                </button>
                                                <button t-if="record.direction.raw_value === 'incoming'" name="action_create_business_action" type="object" class="btn btn-sm btn-outline-secondary">
                                                    <i class="fa fa-bolt"/> Action
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_smsmobileapi_conversation_search" model="ir.ui.view">
        <field name="name">smsmobileapi.conversation.search</field>
        <field name="model">smsmobileapi.conversation</field>
        <field name="arch" type="xml">
            <search string="Search conversations">
                <field name="partner_id"/>
                <field name="phone_number"/>
                <field name="message_search"/>
                <field name="assigned_user_id"/>
                <filter string="Unread" name="unread" domain="[('unread_count', '&gt;', 0)]"/>
                <filter string="My conversations" name="mine" domain="[('assigned_user_id', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('assigned_user_id', '=', False)]"/>
                <filter string="Important" name="important" domain="[('priority', '!=', '0')]"/>
                <separator/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="In progress" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Resolved" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Assigned user" name="group_user" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Contact" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Mobile" name="group_mobile" context="{'group_by': 'last_mobile_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_smsmobileapi_conversation" model="ir.actions.act_window">
        <field name="name">SMS Conversations</field>
        <field name="res_model">smsmobileapi.conversation</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="search_view_id" ref="view_smsmobileapi_conversation_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Your shared SMS inbox is ready.</p>
            <p>Incoming SMS and calls will be grouped automatically by contact and phone number.</p>
        </field>
    </record>
</odoo>
