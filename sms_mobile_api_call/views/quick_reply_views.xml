<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_smsmobileapi_quick_reply_tree" model="ir.ui.view">
        <field name="name">smsmobileapi.quick.reply.tree</field>
        <field name="model">smsmobileapi.quick.reply</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="message"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="view_smsmobileapi_quick_reply_form" model="ir.ui.view">
        <field name="name">smsmobileapi.quick.reply.form</field>
        <field name="model">smsmobileapi.quick.reply</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Example: I will call you back"/></h1></div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" placeholder="Write the reusable SMS text…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_smsmobileapi_quick_reply" model="ir.actions.act_window">
        <field name="name">Quick Replies</field>
        <field name="res_model">smsmobileapi.quick.reply</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
